# Kailashe env — copy to .env and fill values (never commit .env)
MODEL_API_KEY=
KAILASHE_MODEL=muse-spark-1.3
KAILASHE_LLM_BASE_URL=https://api.meta.ai/v1
KAILASHE_ALLOW_CONTRIBUTOR_TIER=
KAILASHE_MODEL_BUDGET_USD=3
KAILASHE_MARKET_BUDGET_USD=
DATAFORSEO_API_KEY=
SERPAPI_API_KEY=
SEMRUSH_API_KEY=
AHREFS_API_KEY=
GOOGLE_TRENDS_API_KEY=
KAILASHE_E2E=
# kailashe.com static hosting (`kailashe deploy`): personal token from
# your kailashe.com account. Read from env only; never logged or saved.
KAILASHE_TOKEN=
KAILASHE_BASE_URL=https://www.kailashe.com
# Tenant subdomains (operator only; end users never set these).
# Platform domain users claim labels on; DNS writes go to whichever
# provider hosts that zone. Tokens are read from env, never logged.
KAILASHE_PLATFORM_DOMAIN=kailashe.tech
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
